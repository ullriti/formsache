# Formsache — Vorlage für die lokale Entwicklungsumgebung.
#
#   ./scripts/dev-setup.sh      # legt `.env` an, erzeugt Schlüssel, gleicht ab
#
# Nach jedem `git pull` einmal laufen lassen: das Skript trägt neue Variablen
# nach und lässt vorhandene Werte unangetastet. `.env` steht in `.gitignore`
# und gehört nie ins Repository.
#
# Für einen Server gilt `.env.prod.example` (`./scripts/prod-setup.sh`).
#
# Ausführlicher: `docs/kb/04-build-run.md` (Entwicklung) und
# `docs/kb/09-betrieb.md` (Betrieb) — dort steht auch, was **nicht** mehr hier
# steht, etwa Mailserver, Basis-Adresse und die KI-Einstellungen.

# ---------------------------------------------------------------------------
# Laufzeit
# ---------------------------------------------------------------------------

# Betriebsmodus: development | test | production. Er entscheidet die Vorgabe von SESSION_COOKIE_SECURE (siehe unten) — mit `production` wäre die Anmeldung lokal über http kaputt.
NODE_ENV=development

# `Secure` am Sitzungs-Cookie: true | false. Leer heißt „wie NODE_ENV" — also lokal ohne `Secure`, und nur deshalb geht die Anmeldung über plain http.
# ⚠️ `false` (bzw. leer bei NODE_ENV=development) verzichtet auf den `__Host-`-Präfix und damit auf den Schutz davor, dass eine Nachbardomain das Sitzungs-Cookie setzt. Nur für einen Betrieb ohne TLS im eigenen Netz, niemals für eine öffentlich erreichbare Installation.
# ⚠️ Ein Wechsel des Wertes wechselt den Cookie-Namen: alle offenen Sitzungen sind danach abgemeldet.
SESSION_COOKIE_SECURE=

# Version, die `GET /api/health` meldet. Lokal ein Platzhalter.
APP_VERSION=0.0.0-dev

# Lebensdauer einer angemeldeten Sitzung in Stunden (1 bis 720).
SESSION_TTL_HOURS=12

# Schlüssel (32 Byte base64), mit dem gespeicherte Geheimnisse verschlüsselt werden. Ohne ihn startet die API nicht; `dev-setup.sh` erzeugt ihn.
SECRET_BOX_KEY=

# Erlaubte Hosts für die OIDC-Discovery, kommagetrennt. Leer heißt: jeder öffentlich erreichbare Host.
OIDC_ISSUER_ALLOWLIST=

# Absoluter Pfad, unter dem hochgeladene Dateien liegen. Ohne ihn startet die API nicht; `dev-setup.sh` setzt `<Repo>/var/files` und legt das Verzeichnis an.
FILE_STORAGE_DIR=

# ---------------------------------------------------------------------------
# Hintergrundjobs — Takte in Millisekunden, `0` schaltet den Job ab
#
# Ein größerer Wert verschiebt nur den Zeitpunkt, nie die Frist selbst; die
# Fristen stehen im Code.
# ---------------------------------------------------------------------------

# Wie oft der Mail-Versand die Warteschlange abarbeitet.
MAIL_WORKER_INTERVAL_MS=15000

# Wie oft das Versandprotokoll aufgeräumt wird (Frist: 90 Tage).
MAIL_PURGE_INTERVAL_MS=86400000

# Wie oft unbeanspruchte Datei-Uploads gelöscht werden (Frist: 24 Stunden).
FILE_PURGE_INTERVAL_MS=86400000

# Wie oft der Papierkorb endgültig geleert wird (Frist: 30 Tage).
TRASH_PURGE_INTERVAL_MS=86400000

# Wie oft abgelaufene Sitzungen gelöscht werden (Frist: 7 Tage).
SESSION_PURGE_INTERVAL_MS=86400000

# Wie oft gespeicherte KI-Eingaben gelöscht werden (Frist: 30 Tage).
AI_USAGE_PURGE_INTERVAL_MS=86400000

# Zeitlimit für eine KI-Erzeugung (1000 bis 600000). Danach bricht die Anfrage ab.
AI_REQUEST_TIMEOUT_MS=60000

# Wie oft die Betriebsüberwachung ihre Schwellen prüft; `0` schaltet die Alarmierung ab, die Ansicht bleibt.
OPS_ALERT_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Netz und Ports
# ---------------------------------------------------------------------------

# Wie viele Reverse-Proxys vor der API stehen (0 bis 8). Zu niedrig heißt: alle Nutzer teilen sich ein Rate-Limit. Zu hoch heißt: ein erfundener Kopfeintrag umgeht es. Im Container-Stack am Dienst gesetzt.
# TRUST_PROXY_HOPS=0

# Port, auf dem der API-Server lauscht.
API_PORT=3000

# Host-Port des Container-Stacks.
APP_PORT=8080

# Auf welcher Adresse der Container-Stack diesen Port veröffentlicht. `127.0.0.1` heißt: nur von diesem Rechner erreichbar.
# Für „von einem anderen Gerät im Netz ausprobieren" die eigene Adresse eintragen (etwa 192.168.1.10) oder `0.0.0.0`. Dann ist der Stack im ganzen Netz erreichbar — mit den Seed-Konten und `change-me-locally` als Passwort.
APP_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------

# Rolle der lokalen Postgres-Instanz.
POSTGRES_USER=formsache

# Passwort der lokalen Instanz — ein Platzhalter für die Entwicklung, kein Geheimnis.
POSTGRES_PASSWORD=change-me-locally

# Name der lokalen Datenbank.
POSTGRES_DB=formsache

# Host-Port der Datenbank, nur auf 127.0.0.1 gebunden.
POSTGRES_PORT=5432

# Verbindung für die Anwendung und die Werkzeuge auf diesem Rechner. Die vier Werte oben stehen hier ausgeschrieben — die Datei kennt keine Verweise.
DATABASE_URL=postgresql://formsache:change-me-locally@127.0.0.1:5432/formsache

# ---------------------------------------------------------------------------
# Nur für die Skripte
#
# Alles ab hier liest kein Container, sondern die Werkzeuge auf diesem
# Rechner: Vite, Playwright, die Testdatenbank und der Entwicklungs-Seed.
# ---------------------------------------------------------------------------

# Port des Vite-Dev- und -Preview-Servers.
WEB_PORT=5173

# Basis-URL, gegen die `pnpm e2e` prüft; leer = lokaler Server auf $WEB_PORT.
# E2E_BASE_URL=

# Kennzeichnet einen CI-Lauf; gesetzt vom CI-System, lokal leer.
# CI=

# Basis-Verbindung für Wegwerf-Testdatenbanken (die Rolle braucht `CREATEDB`); leer = Container bzw. DATABASE_URL.
# TEST_DATABASE_URL=

# Woher die Testdatenbank kommt: auto | testcontainers | external.
# TEST_DATABASE_STRATEGY=auto

# Lokaler Administrator; ein zweiter Seed-Lauf setzt das Passwort nicht zurück.
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_NAME=Administrator Beispiel
SEED_ADMIN_PASSWORD=change-me-locally

# Zweites Konto: Mitglied in beiden Organisationen, mit dem geringsten Recht — damit die Rechteprüfung jemanden abzulehnen hat.
SEED_MEMBER_EMAIL=mitglied@example.org
SEED_MEMBER_NAME=Mitglied Beispiel
SEED_MEMBER_PASSWORD=change-me-locally

# Drittes Konto: Administrator der zweiten Organisation, ausdrücklich kein Superadministrator.
SEED_TENANT_ADMIN_EMAIL=orgadmin@musterstadt.example
SEED_TENANT_ADMIN_NAME=Musterstadt Organisationsadmin
SEED_TENANT_ADMIN_PASSWORD=change-me-locally
