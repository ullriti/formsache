# Formsache — Vorlage für die `.env` einer Produktivinstallation.
#
#   ./scripts/prod-setup.sh     # legt `.env` an und erzeugt die Geheimnisse
#
# Diese Datei wird auf den Server kopiert und dort gefüllt. Sie darf **nie** ins
# Repository zurückwandern; die Geheimnisse unten stehen bewusst leer.
#
# Der Stack läuft mit:
#
#   docker compose -f docker-compose.prod.yml up -d
#
# TLS und die Erreichbarkeit von außen macht der eigene Reverse-Proxy vor dem
# Dienst `web` — dazu steht nichts in dieser Datei.
#
# Das Betriebshandbuch ist `docs/kb/09-betrieb.md`. Dort steht auch, was
# **nicht** mehr hier steht: Mailserver, Basis-Adresse und die
# KI-Einstellungen sind Systemeinstellungen in der Anwendung.

# ---------------------------------------------------------------------------
# Welche Images gefahren werden
# ---------------------------------------------------------------------------

# Registry-Präfix der Images. Nur ändern, wenn eine eigene Registry benutzt wird.
IMAGE_PREFIX=ghcr.io/ullriti

# Der Stand, den diese Installation fährt, und die Version, die `/api/health`
# meldet. `latest` ist der jeweils neueste Stand; für einen festen Stand eine
# Version aus der Übersicht eintragen:
# https://github.com/ullriti/formsache/pkgs/container/formsache-api
APP_VERSION=latest

# ---------------------------------------------------------------------------
# Laufzeit
# ---------------------------------------------------------------------------

# Lebensdauer einer angemeldeten Sitzung in Stunden (1 bis 720).
SESSION_TTL_HOURS=12

# `Secure` am Sitzungs-Cookie: true | false. Bei `true` bleiben — die dokumentierte Betriebsgestalt hat TLS vor dem Dienst `web`.
# Nur ein Fall rechtfertigt `false`: eine Installation, die über plain http im eigenen Netz erreicht wird. Ein Browser nimmt ein `Secure`-Cookie über `http://localhost` an, verwirft es aber über `http://192.168.1.10` — die Anmeldung antwortet dann mit 200 und jede weitere Anfrage ist anonym.
# ⚠️ Der Preis: ohne `Secure` fällt der `__Host-`-Präfix weg, und damit der Schutz davor, dass eine Nachbardomain unter derselben Elterndomain das Sitzungs-Cookie setzt (Cookie-Tossing). Niemals für eine öffentlich erreichbare Installation.
# ⚠️ Ein Wechsel des Wertes wechselt den Cookie-Namen: alle offenen Sitzungen sind danach abgemeldet.
SESSION_COOKIE_SECURE=true

# Erlaubte Hosts für die OIDC-Discovery, kommagetrennt. Leer heißt: jeder öffentlich erreichbare Host.
OIDC_ISSUER_ALLOWLIST=

# Aus welchem Netz der Frontdoor ein `X-Forwarded-For` glaubt. Die Vorgabe deckt die Netze ab, die Docker vergibt, und passt für einen Reverse-Proxy auf demselben Host. Zu weit gesetzt heißt: ein erfundener Kopfeintrag umgeht das Rate-Limit.
# TRUSTED_PROXY_CIDR=172.16.0.0/12

# ---------------------------------------------------------------------------
# Geheimnisse — von `prod-setup.sh` erzeugt, nie aus dem Repository
# ---------------------------------------------------------------------------

# Schlüssel (32 Byte base64), mit dem gespeicherte Geheimnisse verschlüsselt werden. Er gehört in die Sicherung: verloren heißt, dass Zugangswörter und hinterlegte Zugangsdaten unlesbar sind.
SECRET_BOX_KEY=

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------

# Rolle der Postgres-Instanz.
POSTGRES_USER=formsache

# Passwort der Rolle. Ohne Wert startet der Stack nicht — `prod-setup.sh` erzeugt eines.
POSTGRES_PASSWORD=

# Name der Datenbank.
POSTGRES_DB=formsache

# ---------------------------------------------------------------------------
# Hintergrundjobs — Takte in Millisekunden, `0` schaltet den Job ab
#
# Ein größerer Wert verschiebt nur den Zeitpunkt, nie die Frist selbst; die
# Fristen stehen im Code. `0` heißt: es wird nie gelöscht.
# ---------------------------------------------------------------------------

# Wie oft der Mail-Versand die Warteschlange abarbeitet.
MAIL_WORKER_INTERVAL_MS=15000

# Wie oft das Versandprotokoll aufgeräumt wird (Frist: 90 Tage).
MAIL_PURGE_INTERVAL_MS=86400000

# Wie oft unbeanspruchte Datei-Uploads gelöscht werden (Frist: 24 Stunden).
FILE_PURGE_INTERVAL_MS=86400000

# Wie oft der Papierkorb endgültig geleert wird (Frist: 30 Tage).
TRASH_PURGE_INTERVAL_MS=86400000

# Wie oft abgelaufene Sitzungen gelöscht werden (Frist: 7 Tage).
SESSION_PURGE_INTERVAL_MS=86400000

# Wie oft gespeicherte KI-Eingaben gelöscht werden (Frist: 30 Tage).
AI_USAGE_PURGE_INTERVAL_MS=86400000

# Zeitlimit für eine KI-Erzeugung (1000 bis 600000). Danach bricht die Anfrage ab.
AI_REQUEST_TIMEOUT_MS=60000

# Wie oft die Betriebsüberwachung ihre Schwellen prüft; `0` schaltet die Alarmierung ab, die Ansicht bleibt.
OPS_ALERT_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Nur für die Skripte
#
# Alles ab hier liest kein Container, sondern `scripts/backup.sh` und
# `scripts/restore.sh` auf dem Host. Datenbankadresse und Upload-Verzeichnis
# ermitteln die beiden selbst aus dem laufenden Stack.
# ---------------------------------------------------------------------------

# Schlüssel, mit dem das Sicherungsarchiv verschlüsselt wird. **Nicht** derselbe wie `SECRET_BOX_KEY`, und beide gehören woanders hin als das Archiv.
BACKUP_KEY=

# Wohin `scripts/backup.sh` schreibt — nicht auf den Datenträger, den es sichert.
BACKUP_DIR=/var/backups/formsache

# Wie lange Archive dort bleiben, in Tagen.
BACKUP_KEEP_DAYS=30
