{
  "name": "@formsache/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS-Backend von Formsache",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/main.js",
  "files": [
    "dist",
    "prisma/schema.prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "postinstall": "prisma generate",
    "reset-data": "node --require @swc-node/register prisma/reset-data.ts",
    "dev": "prisma generate && node --watch --require @swc-node/register src/main.ts",
    "seed": "prisma db seed",
    "create-superadmin": "node --require @swc-node/register src/setup/create-superadmin.main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "load-test": "node --require @swc-node/register test/load/anmeldestart.ts"
  },
  "dependencies": {
    "@formsache/shared": "workspace:*",
    "@anthropic-ai/sdk": "0.135.0",
    "@mistralai/mistralai": "2.7.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "nodemailer": "10.1.2",
    "openid-client": "6.8.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@formsache/test-idp": "workspace:*",
    "@nestjs/testing": "12.1.3",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
    "exceljs": "4.4.0",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "smtp-server": "3.19.23",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "catalog:"
  }
}
