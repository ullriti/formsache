{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    // Type checking and linting read @formsache/shared from source, so a broken
    // wire contract shows up immediately (ADR-0007). The emitting config
    // below resets this and resolves the built artifact instead.
    "paths": {
      "@formsache/shared": ["../../packages/shared/src/index.ts"],
      // The one OpenID provider of the suite, for `test/auth/*`. Mapped to
      // the source like everything else this workspace shares, so it needs
      // no build of its own before a typecheck.
      "@formsache/test-idp": ["../../packages/test-idp/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "prisma/**/*.ts",
    "vitest.config.ts",
    "prisma.config.ts"
  ]
}
