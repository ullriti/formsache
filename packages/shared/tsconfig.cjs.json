{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    // TypeScript 6 deprecates `node10` resolution; see apps/api/tsconfig.json
    // for why the move to `node16` is deferred and not part of the bump.
    "ignoreDeprecations": "6.0",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "dist/cjs"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
